---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ContadorReto from '../components/ContadorReto.astro';
import Hito from '../components/Hito.astro';
import CuentaRegresiva from '../components/CuentaRegresiva.astro';
import Redes from '../components/Redes.astro';
import Videos from '../components/Videos.astro';
import Footer from '../components/Footer.astro';
import Historia from '../components/Historia.astro';
import Lugares from '../components/Lugares.astro';
import { config } from '../config';
import { calcularEstado, miles } from '../lib/reto';

// Estado al momento del build: sirve para el HTML inicial. En el navegador se recalcula con la fecha real.
const estado = calcularEstado();

// Título y descripción sin el día actual: WhatsApp, Facebook y Google guardan la vista previa
// en caché, y un "Día 293" fijo se vería viejo en pocos días. La pestaña del navegador
// sí muestra el día en vivo (lo actualiza el script de abajo).
const { totalDias } = config;
const totalFlexiones = miles((totalDias * (totalDias + 1)) / 2);
const titulo = `${config.marca} · El reto de ${totalDias} días de flexiones de ${config.nombre}`;
const descripcion =
  config.flexionesPorDia === 'igual-al-dia'
    ? `Cada día, tantas flexiones como el número del día: ${totalDias} días y ${totalFlexiones} flexiones. Sigue en vivo el reto de ${config.nombre}. 💪`
    : `Sigue en vivo el reto de ${totalDias} días de flexiones de ${config.nombre}. ${config.frase}.`;
---

<Base titulo={titulo} descripcion={descripcion}>
  <!--
    Móvil: una columna en orden natural.
    Escritorio: hero + contador a la izquierda, lo en vivo a la derecha y las secciones de historia abajo a todo el ancho.
  -->
  <main
    class="mx-auto max-w-md px-5 pt-[env(safe-area-inset-top)] lg:grid lg:max-w-6xl lg:grid-cols-[1.1fr_1fr] lg:grid-rows-[auto_1fr_auto_auto] lg:gap-x-16 lg:px-10 lg:[grid-template-areas:'izq_der'_'izq_der2'_'extra_extra'_'pie_pie']"
  >
    <div class="lg:flex lg:min-h-svh lg:flex-col lg:justify-center lg:self-start lg:pb-8 lg:[grid-area:izq]">
      <Hero />
      <ContadorReto estado={estado} />
    </div>

    <div class="lg:pt-6 lg:[grid-area:der]">
      <div data-vista="activo" hidden={estado.completado}>
        <Hito estado={estado} />
      </div>
      <CuentaRegresiva estado={estado} />
    </div>

    <div class="lg:[grid-area:extra]">
      <Historia />
      <Lugares />
      <Videos />
    </div>

    <div class="lg:[grid-area:der2]">
      <blockquote data-revelar class="mt-14 rounded-3xl border-l-[6px] border-oro bg-white/[0.04] px-6 py-7">
        <span class="block font-display text-6xl leading-[0.5] text-oro" aria-hidden="true">“</span>
        <p class="mt-2 text-2xl leading-snug font-extrabold text-balance">{config.frase}</p>
        <footer class="mt-4 text-sm font-bold tracking-widest text-oro uppercase">— {config.nombre}</footer>
      </blockquote>

      <Redes />
    </div>

    <div class="lg:[grid-area:pie]">
      <Footer />
    </div>
  </main>
</Base>

<script>
  import '../scripts/efectos';
  import { config } from '../config';
  import { calcularEstado, dosDigitos, miles, pct, type Estado } from '../lib/reto';

  const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const el = (clave: string) => document.querySelector<HTMLElement>(`[data-r="${clave}"]`);
  const texto = (clave: string, valor: string) => {
    const nodo = el(clave);
    if (nodo && nodo.textContent !== valor) nodo.textContent = valor;
  };
  const ancho = (clave: string, porcentaje: number) => {
    const nodo = el(clave);
    if (nodo) nodo.style.width = `${porcentaje}%`;
  };

  const contando = new Set<string>();
  let segundoAnterior = -1;

  /** Animación de entrada: el número sube desde 0 hasta su valor. */
  function contarHasta(clave: string, valor: number, formato: (n: number) => string = String) {
    const nodo = el(clave);
    if (!nodo || reducido || valor < 2) return;
    contando.add(clave);
    const inicio = performance.now() + 250;
    const duracion = 1400;
    const paso = (t: number) => {
      const avance = Math.min(1, Math.max(0, (t - inicio) / duracion));
      nodo.textContent = formato(Math.round(valor * (1 - (1 - avance) ** 3)));
      if (avance < 1) requestAnimationFrame(paso);
      else contando.delete(clave);
    };
    nodo.textContent = formato(0);
    requestAnimationFrame(paso);
  }

  function pintar(e: Estado) {
    document.querySelectorAll<HTMLElement>('[data-vista]').forEach((nodo) => {
      nodo.hidden = (nodo.dataset.vista === 'completado') !== e.completado;
    });
    document.title = e.completado
      ? `${config.marca} · Reto completado ${e.totalDias}/${e.totalDias}`
      : `${config.marca} · Día ${e.dia} de ${e.totalDias}`;
    if (e.flexiones !== null && !contando.has('flexiones')) texto('flexiones', miles(e.flexiones));
    if (e.completado) return;

    if (e.flexionesHoy !== null) texto('flexiones-hoy', miles(e.flexionesHoy));
    if (!contando.has('dia')) texto('dia', String(e.dia));
    texto('pct', pct(e.porcentaje));
    ancho('barra', e.porcentaje);

    const tarjeta = el('hito-tarjeta');
    if (tarjeta) tarjeta.toggleAttribute('data-celebrando', e.hito.celebrando);
    texto('hito-etiqueta', e.hito.etiqueta);
    texto('hito-titulo', e.hito.titulo);
    texto('hito-detalle', e.hito.detalle);
    texto('hito-dia', `Día ${e.dia}`);
    texto('hito-meta', `Meta: día ${e.hito.meta}`);
    ancho('hito-barra', e.hito.porcentaje);
    const superado = el('hito-superado');
    if (superado) superado.hidden = !e.hito.superado || e.hito.celebrando;

    const { dias, horas, minutos, segundos } = e.cuenta;
    texto('cuenta-dias', String(dias));
    texto('cuenta-horas', dosDigitos(horas));
    texto('cuenta-minutos', dosDigitos(minutos));
    texto('cuenta-segundos', dosDigitos(segundos));

    const seg = el('cuenta-segundos');
    if (seg && !reducido && segundoAnterior !== -1 && segundoAnterior !== segundos) {
      seg.classList.remove('animate-latido');
      void seg.offsetWidth;
      seg.classList.add('animate-latido');
    }
    segundoAnterior = segundos;
  }

  function tic() {
    pintar(calcularEstado());
    setTimeout(tic, 1000 - (Date.now() % 1000) + 5);
  }

  const inicial = calcularEstado();
  pintar(inicial);
  if (!inicial.completado) contarHasta('dia', inicial.dia);
  if (inicial.flexiones !== null) contarHasta('flexiones', inicial.flexiones, miles);
  setTimeout(tic, 1000 - (Date.now() % 1000) + 5);
</script>
