---
import { config } from '../config';

const { videos } = config;
const flecha =
  'grid size-11 place-items-center rounded-full border-[3px] border-black bg-oro text-black shadow-[0_3px_0_#000] transition hover:brightness-110 active:translate-y-0.5 active:shadow-none disabled:cursor-default disabled:opacity-30';
---

{
  videos.length > 0 && (
    <section class="mt-14 lg:mt-20" aria-label="Videos del reto">
      <div class="flex items-end justify-between gap-4">
        <h2 data-revelar="sello" class="font-display text-[clamp(1.6rem,7.5vw,2rem)] leading-none uppercase sticker-oro -rotate-2 lg:text-5xl">Videos del reto</h2>
        <div class="flex items-center gap-4">
          <a
            href={config.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold tracking-wider text-white/60 uppercase hover:text-oro"
          >
            Ver todos ↗
          </a>
          <div data-flechas hidden class="hidden gap-2 lg:flex">
            <button type="button" data-mover="-1" class={flecha} aria-label="Video anterior">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                <path d="m15 5-7 7 7 7" />
              </svg>
            </button>
            <button type="button" data-mover="1" class={flecha} aria-label="Video siguiente">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                <path d="m9 5 7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div
        data-carrusel
        class="-mx-5 mt-5 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-px-5 px-5 pt-1 pb-4 [scrollbar-width:none] lg:mx-0 lg:mt-8 lg:scroll-px-0 lg:justify-center-safe lg:gap-6 lg:px-0 [&::-webkit-scrollbar]:hidden"
      >
        {videos.map((video, i) => (
          <a
            href={video.url}
            target="_blank"
            rel="noopener noreferrer"
            data-tarjeta
            data-tilt
            aria-label={`Ver en Instagram: ${video.titulo ?? (video.dia ? `Día ${video.dia}` : `Video ${i + 1}`)}`}
            class="group relative aspect-[9/16] w-[62%] shrink-0 snap-start overflow-hidden rounded-3xl border-[3px] border-black bg-gradient-to-br from-oro-oscuro/60 via-zinc-900 to-noche shadow-[0_5px_0_#000] transition hover:-translate-y-1 hover:shadow-[0_9px_0_#000] active:translate-y-1 active:shadow-[0_1px_0_#000] sm:w-[40%] lg:w-[calc((100%-4.5rem)/4)]"
          >
            {video.portada ? (
              <img
                src={video.portada}
                alt=""
                loading={i < 2 ? 'eager' : 'lazy'}
                class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105"
              />
            ) : (
              video.dia && (
                <span class="absolute inset-x-0 top-[9%] text-center font-display leading-none -rotate-[4deg]">
                  <span class="block text-3xl sticker-oro">DÍA</span>
                  <span class="block text-7xl sticker">{video.dia}</span>
                </span>
              )
            )}

            <span class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/10 to-transparent" />

            <span class="absolute top-1/2 left-1/2 grid size-16 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-[3px] border-black bg-oro shadow-[0_4px_0_#000] transition group-hover:scale-110">
              <svg class="ml-1 size-7 text-black" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z" />
              </svg>
            </span>

            {video.portada && video.dia && (
              <span class="absolute top-3 left-3 rounded-full border-2 border-black bg-oro px-2.5 py-0.5 font-display text-base text-black">
                DÍA {video.dia}
              </span>
            )}

            <span class="absolute inset-x-0 bottom-0 p-4 text-left">
              {video.titulo && <span class="block text-base leading-tight font-extrabold text-balance">{video.titulo}</span>}
              <span class="mt-1.5 flex items-center gap-1.5 text-xs font-bold text-white/70">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4.2" />
                </svg>
                Ver en Instagram
              </span>
            </span>
          </a>
        ))}
      </div>

      {videos.length > 1 && (
        <div data-puntos class="mt-1 flex justify-center gap-2" aria-hidden="true">
          {videos.map((_, i) => (
            <span
              data-punto
              class:list={[
                'h-2 rounded-full transition-all duration-300',
                i === 0 ? 'w-6 bg-oro' : 'w-2 bg-white/25',
              ]}
            />
          ))}
        </div>
      )}
    </section>
  )
}

<script>
  const carrusel = document.querySelector<HTMLElement>('[data-carrusel]');
  const tarjetas = [...document.querySelectorAll<HTMLElement>('[data-tarjeta]')];
  const puntos = document.querySelectorAll<HTMLElement>('[data-punto]');
  const contPuntos = document.querySelector<HTMLElement>('[data-puntos]');
  const flechas = document.querySelector<HTMLElement>('[data-flechas]');
  const [anterior, siguiente] = document.querySelectorAll<HTMLButtonElement>('[data-mover]');

  if (carrusel && tarjetas.length) {
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const marcar = (activo: number) => {
      puntos.forEach((punto, i) => {
        punto.classList.toggle('w-6', i === activo);
        punto.classList.toggle('bg-oro', i === activo);
        punto.classList.toggle('w-2', i !== activo);
        punto.classList.toggle('bg-white/25', i !== activo);
      });
    };

    const paso = () => tarjetas[0].offsetWidth + parseFloat(getComputedStyle(carrusel).columnGap || '0');

    // Flechas y puntos solo cuando hay más videos de los que caben.
    const actualizar = () => {
      const desborda = carrusel.scrollWidth > carrusel.clientWidth + 1;
      const alFinal = carrusel.scrollLeft + carrusel.clientWidth >= carrusel.scrollWidth - 1;
      marcar(alFinal ? tarjetas.length - 1 : Math.round(carrusel.scrollLeft / paso()));
      if (flechas) flechas.hidden = !desborda;
      if (contPuntos) contPuntos.hidden = !desborda;
      if (anterior && siguiente) {
        anterior.disabled = carrusel.scrollLeft <= 1;
        siguiente.disabled = alFinal;
      }
    };

    document.querySelectorAll<HTMLButtonElement>('[data-mover]').forEach((boton) => {
      boton.addEventListener('click', () => {
        carrusel.scrollBy({ left: Number(boton.dataset.mover) * paso(), behavior: reducido ? 'auto' : 'smooth' });
      });
    });

    carrusel.addEventListener('scroll', actualizar, { passive: true });
    new ResizeObserver(actualizar).observe(carrusel);
    actualizar();
  }
</script>
