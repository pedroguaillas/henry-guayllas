---
import { config } from '../config';

const base =
  'flex w-full items-center justify-center gap-3 rounded-2xl border-[3px] border-black px-6 py-4 text-lg font-extrabold shadow-[0_5px_0_#000] transition active:translate-y-1 active:shadow-[0_1px_0_#000]';
---

<section data-revelar class="mt-14 text-center">
  <h2 class="text-xs font-extrabold tracking-[0.3em] text-white/60 uppercase">Sigue el reto</h2>
  <div class="mt-4 flex flex-col gap-4">
    <a
      href={config.instagram}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[base, 'bg-gradient-to-r from-[#f58529] via-[#dd2a7b] to-[#8134af] text-white']}
    >
      <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4.2"></circle>
        <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"></circle>
      </svg>
      Síguelo en Instagram
    </a>
    <a href={config.facebook} target="_blank" rel="noopener noreferrer" class:list={[base, 'bg-[#1877f2] text-white']}>
      <svg class="size-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.5 1.6-1.5h1.7V4.4a22 22 0 0 0-2.5-.1c-2.4 0-4.1 1.5-4.1 4.2v2.3H7.5V14h2.7v8h3.3Z"></path>
      </svg>
      Síguelo en Facebook
    </a>
  </div>
</section>
