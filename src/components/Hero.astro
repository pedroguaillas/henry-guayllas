---
import { config } from '../config';
---

<header class="flex flex-col items-center pt-8 text-center">
  <div class="relative motion-safe:animate-subir">
    <div class="relative motion-safe:animate-flotar">
    <div
      class="relative grid size-32 place-items-center lg:size-40 overflow-hidden rounded-full border-[5px] border-oro bg-gradient-to-br from-oro-oscuro to-zinc-900 shadow-[0_0_0_4px_#000,0_0_48px_rgb(255_198_41/0.35)]"
    >
      <span class="font-display text-6xl text-oro sticker-oro" aria-hidden="true">H</span>
      <img
        src="/henry.jpg"
        alt={config.nombre}
        width="256"
        height="256"
        class="absolute inset-0 size-full origin-[50%_14%] scale-[1.9] object-cover object-[50%_14%]"
        onerror="this.remove()"
      />
    </div>
    <svg
      class="absolute -top-7 left-1/2 w-14 origin-bottom -translate-x-1/2 -rotate-6 drop-shadow-[0_3px_0_#000] motion-safe:animate-corona"
      viewBox="0 0 24 16"
      aria-hidden="true"
    >
      <path d="M2 14 3.5 3l5 5L12 1l3.5 7 5-5L22 14Z" fill="#ffc629" stroke="#000" stroke-width="1.4" stroke-linejoin="round"></path>
    </svg>
    </div>
  </div>

  <h1 class="mt-5 font-display text-5xl leading-none lg:text-7xl uppercase sticker-oro motion-safe:animate-subir motion-safe:[animation-delay:120ms]">
    {config.marca}<span class="sr-only">: el reto de {config.totalDias} días de flexiones de {config.nombre}</span>
  </h1>
  <p class="mt-3 text-sm font-semibold tracking-[0.35em] text-white/70 uppercase motion-safe:animate-subir motion-safe:[animation-delay:220ms]">
    {config.lema}
  </p>
</header>
